#!/usr/bin/env bash
set -euo pipefail

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == refs/heads/main ]]; then
    if [[ "$local_sha" =~ ^0+$ ]]; then
      printf 'Do not delete main.\n' >&2
      exit 1
    fi
    if [[ ! "$remote_sha" =~ ^0+$ ]] &&
      ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      printf 'Only fast-forward pushes are allowed for main. Fetch before pushing.\n' >&2
      exit 1
    fi
  fi
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  blocked="$(git log --format= --name-only --no-renames --diff-filter=ACM \
    "$local_sha" --not --remotes=origin -- \
    benchmarks .cade e2e-results benchmark-results eval-results evals)"
  if [[ -n "$blocked" ]]; then
    printf 'New public history contains internal assets:\n%s\n' "$blocked" >&2
    exit 1
  fi
done
